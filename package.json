{
  "name": "grounded-rules",
  "version": "26.8.4",
  "private": true,
  "description": "Grounded Rules — CI Ops constitution, Dewey codes, manifest, reusable workflows",
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "validate:manifest": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/ci-ops/src/validate-manifest.ts",
    "versions:fleet": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/ci-ops/src/collect-versions.ts",
    "versions:fleet:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/ci-ops/src/collect-versions.ts --check",
    "ci-ops:version": "node -e \"console.log(require('./package.json').version)\"",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p packages/ci-ops/tsconfig.json --noEmit",
    "test:workspace": "playwright test --config=tests/playwright.config.ts",
    "test:workspace:contract": "playwright test --config=tests/playwright.config.ts --project=contract",
    "test:playwright-kit": "node --test playwright-kit/scripts/playwright-feature-tags.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "CI_OPS_CONSTITUTION.md",
    "codes",
    "subterra.manifest.yaml",
    "versions",
    "Docs/VERSIONS.md",
    "packages/ci-ops",
    "templates",
    "playwright-kit",
    ".github/workflows"
  ]
}
